-- 式は「ヘルパー群 + function(...) 式 end」として 1 回だけコンパイルし、t を引数で渡す。
-- ヘルパーは st / ed などを上位値で読む
local _PRELUDE = [==[
local obj, st, ed, index, num, slot
local pi,tau,e=math.pi,math.pi*2,2.718281828459045
local abs,floor,ceil,sqrt=math.abs,math.floor,math.ceil,math.sqrt
local sin,cos,tan=math.sin,math.cos,math.tan
local atan,atan2=math.atan,math.atan2
local exp,log,fmod=math.exp,math.log,math.fmod
local max,min=math.max,math.min
local inf=math.huge
local function clamp(v,lo,hi)return max(lo,min(hi,v))end
local function lerp(a,b,t)return a+(b-a)*t end
local mix=lerp
local function round(x)return floor(x+0.5)end
local function fract(x)return x-floor(x)end
local function sign(x)return x>0 and 1 or x<0 and -1 or 0 end
local function map(v,a,b,c,d)return c+(d-c)*(v-a)/(b-a)end
local function wrap(v,lo,hi)local r=hi-lo;return lo+fmod(fmod(v-lo,r)+r,r)end
local function snap(v,step)return floor(v/step+0.5)*step end
local function smoothstep(e0,e1,x)
  local t=clamp((x-e0)/(e1-e0),0,1);return t*t*(3-2*t)
end
local function smootherstep(e0,e1,x)
  local t=clamp((x-e0)/(e1-e0),0,1);return t*t*t*(t*(6*t-15)+10)
