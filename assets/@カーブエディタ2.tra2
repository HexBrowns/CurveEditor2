local _ed = obj.getpoint(_idx + 1)
-- CSS cubic-bezier(0.42, 0, 0.58, 1.0) = ease-in-out
local x1,y1,x2,y2 = 0.42, 0, 0.58, 1.0
local function bx(s) return 3*s*(1-s)^2*x1 + 3*s^2*(1-s)*x2 + s^3 end
local function by(s) return 3*s*(1-s)^2*y1 + 3*s^2*(1-s)*y2 + s^3 end
local lo, hi, s = 0, 1, _t
for _ = 1, 25 do
  local x = bx(s)
  if math.abs(x - _t) < 1e-7 then break end
  if x < _t then lo = s else hi = s end
  s = (lo + hi) * 0.5
end
return _st + (_ed - _st) * by(s)

