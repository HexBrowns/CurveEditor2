-- Live の内容かこのスクリプト自身（_PRELUDE）が変わったら作り直す。
-- LuaJIT の文字列は内部化されているので、この比較は長さによらず安い
if _content ~= _C.content or _PRELUDE ~= _C.prelude then
  _C.content = _content
  _C.prelude = _PRELUDE
  _C.prelude_lines = select(2, _PRELUDE:gsub("\n", "\n"))
  _C.fns = {}
  _C.errors = {}
  _C.error_count = 0
end

-- エラーの行番号を式の中の行に直す
local function _user_line(msg)
  return (tostring(msg):gsub("^CurveEditor2:(%d+):", function(l)
    return (tonumber(l) - _C.prelude_lines) .. " 行目:"
  end))
end

local function _get_fn(slot)
  local fn = _C.fns[slot]
  if fn ~= nil then return fn end
  local code = "return t"
  local mk = "@.live." .. tostring(slot) .. "\n"
  local cs
  if _content:sub(1, #mk) == mk then
    cs = #mk + 1
  else
    local si = _content:find("\n" .. mk, 1, true)
    if si then cs = si + 1 + #mk end
  end
  if cs then
    local ns = _content:find("\n@", cs, true)
    local s = ns and _content:sub(cs, ns - 1) or _content:sub(cs)
    if s:match("%S") then code = s end
  end
  -- 末尾の空行を落としてから閉じる（式の終わりで起きた構文エラーの行番号が、最後の行の次になるように）
  code = code:gsub("%s+$", "")
  local chunk, err = load(_PRELUDE .. code .. "\nend", "=CurveEditor2")
  if chunk then
    local ok, made = pcall(chunk)
    if ok and type(made) == "function" then
      fn = made
    else
      fn = false
      _report(slot, _user_line(made))
    end
  else
    fn = false
    _report(slot, "構文エラー: " .. _user_line(err))
  end
  _C.fns[slot] = fn
  return fn
end

-- 式の戻り値（比率）。エラーや数値でない戻り値は t（直線）にする
local function _ratio(slot, t, st, ed, index)
  local fn = _get_fn(slot)
  if not fn then return t end
  local ok, v = pcall(fn, t, obj, st, ed, index, _n, slot)
  if ok then
    if type(v) == "number" then return v end
    return t
  end
  _report(slot, _user_line(v))
  return t
end

-- 加速・減速の折り返し（@Basic_S の reduce_inout_ease と同じ考え方。ただし
-- どちらも OFF は「そのまま」にして v1.0 のトラックの見た目を保つ）。
-- 戻り値は v0 から v1 への比率で、式には折り返した向きの st / ed を見せる
local function _shaped_ratio(slot, t, v0, v1, index)
  if _accel and _decel then
    local mid = (v0 + v1) / 2
    if t < 0.5 then
      return 0.5 * _ratio(slot, 2 * t, v0, mid, index)
    end
    return 1 - 0.5 * _ratio(slot, 2 - 2 * t, v1, mid, index)
  elseif _decel then
    return 1 - _ratio(slot, 1 - t, v1, v0, index)
  end
  return _ratio(slot, t, v0, v1, index)
end

if _n < 2 then
  return _getpoint(0)
end

if _mode == 2 then
  -- 全体で1本: 全体の時間位置にカーブを掛けて時間を歪め、歪めた時間での値を中間点から直線で取る
  local _u = _getpoint("timecontrol", "value")
  local _R = _shaped_ratio(_slot, _u, _getpoint(0), _getpoint(_n - 1), 0)
  local _tt = _R * _getpoint("time", _n - 1)
  local _k = 0
  while _k < _n - 2 and _getpoint("time", _k + 1) <= _tt do
    _k = _k + 1
  end
  local _t0, _t1 = _getpoint("time", _k), _getpoint("time", _k + 1)
  local _s = (_t1 > _t0) and (_tt - _t0) / (_t1 - _t0) or 1
  local _v0, _v1 = _getpoint(_k), _getpoint(_k + 1)
  return _v0 + (_v1 - _v0) * _s
end

local _idx, _t = math.modf(_getpoint("index"))
-- キーフレームちょうど（小数部=0）では次区間の始点として t=0 になる。
-- そのままだと _st がキー値になり、曲線の終点 y≠1（例: 弧で y3=0）のとき
-- 直前フレーム（t→1）から終了キー値へ飛ぶ。直前区間の t=1 として評価する。
if _t == 0 and _idx > 0 then
  _idx = _idx - 1
  _t = 1
end
if _idx >= _n - 1 then
  _idx, _t = _n - 2, 1
elseif _idx < 0 then
  _idx, _t = 0, 0
end
-- 時間制御は区間ごとに掛ける（@Basic_S の 区間ごとに時間制御 と同じ取り方）
_t = _getpoint("timecontrol", "value", _t * _getpoint("time", _n - 1))

local _st = _getpoint(_idx)
local _ed = _getpoint(_idx + 1)
local _use = (_mode == 1) and (_slot + _idx) or _slot
return _st + (_ed - _st) * _shaped_ratio(_use, _t, _st, _ed, _idx)

@バウンス
--label:HexScript
--information:バウンス@カーブエディタ2 v1.10 by HexBrowns

local _idx, _t = math.modf(obj.getpoint("index"))
local _st = obj.getpoint(_idx)
local _ed = obj.getpoint(_idx + 1)
local function _b(t)
  if t < 1/2.75 then return 7.5625*t*t
  elseif t < 2/2.75 then t=t-1.5/2.75; return 7.5625*t*t+0.75
  elseif t < 2.5/2.75 then t=t-2.25/2.75; return 7.5625*t*t+0.9375
  else t=t-2.625/2.75; return 7.5625*t*t+0.984375 end
end
return _st + (_ed - _st) * _b(_t)

@ループバウンス
--label:HexScript
--information:ループバウンス@カーブエディタ2 v1.10 by HexBrowns
--param:周期(フレーム),50

-- 跳ねるような動きを一定周期で無限に繰り返す（減衰なし・ループ向き）
-- 開始値～終了値の間を周期(フレーム数)ごとに往復する
local _idx = math.floor(obj.getpoint("index"))
local _st = obj.getpoint(_idx)
local _ed = obj.getpoint(_idx + 1)
local _period = math.max(1, obj.getpoint("param") or 25)
local _frame = obj.getpoint("time") * obj.getpoint("framerate")
local _phase = math.fmod(_frame, _period) / _period
if _phase < 0 then _phase = _phase + 1 end
local _bounce = 4 * _phase * (1 - _phase) -- 放物線：0→1→0で1周期（境界がなめらかにループ）
return _st + (_ed - _st) * _bounce

@弾性
--label:HexScript
--information:弾性@カーブエディタ2 v1.10 by HexBrowns

local _idx, _t = math.modf(obj.getpoint("index"))
local _st = obj.getpoint(_idx)
local _ed = obj.getpoint(_idx + 1)
local _r
if _t == 0 or _t == 1 then
  _r = _t
else
  local a, p = 1, 0.5
  _r = a * 2^(-10*_t) * math.sin((_t - p/4) * math.pi*2/p) + 1
end
return _st + (_ed - _st) * _r

