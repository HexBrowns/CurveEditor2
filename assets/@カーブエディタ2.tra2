@スプリング
--label:HexScript
--information:スプリング@カーブエディタ2 v1.10 by HexBrowns
--param:減衰比,0.4
--param:角周波数,10.0

local _idx, _t = math.modf(obj.getpoint("index"))
local _st = obj.getpoint(_idx)
local _ed = obj.getpoint(_idx + 1)
local zeta, omega = obj.getpoint("param")
zeta = zeta or 0.4; omega = omega or 10.0
local _r
if _t <= 0 then
  _r = 0
elseif _t >= 1 then
  _r = 1
else
  if zeta < 0 then zeta = 0 end
  if omega <= 0 then
    _r = _t
  else
    local pi = math.pi
    local tp
    if zeta < 1e-6 then tp = _t * (2*pi/omega)
    else tp = _t * (4.605/(zeta*omega)) end
    if zeta < 1 - 1e-6 then
      local wd = omega * math.sqrt(1 - zeta*zeta)
      local env = math.exp(-zeta*omega*tp)
      _r = 1 - env*(math.cos(wd*tp) + (zeta/math.sqrt(1-zeta*zeta))*math.sin(wd*tp))
    elseif zeta < 1 + 1e-6 then
      _r = 1 - math.exp(-omega*tp)*(1 + omega*tp)
    else
      local s = math.sqrt(zeta*zeta - 1)
      local r1 = -omega*(zeta-s); local r2 = -omega*(zeta+s)
      local A = r2/(r1-r2); local B = -r1/(r1-r2)
      _r = 1 + A*math.exp(r1*tp) + B*math.exp(r2*tp)
    end
  end
end
return _st + (_ed - _st) * _r

