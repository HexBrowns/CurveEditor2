end

-- CurveEditor2.aux2 が同期する Live ファイル。内容が変わったときだけ式を作り直す。
-- 置き場所はデータフォルダ（Script と Plugin の親）の Plugin\CurveEditor2\。プラグインは本体の
-- データフォルダの下に書くので、ここでもパスを直書きせず obj.getinfo("script_path") から求める
-- （Script\ と Script\CurveEditor2\ のどちらが返っても通るように、末尾の Script 以降を落とす）。
-- 求められないときは既定のデータフォルダ C:\ProgramData\aviutl2 を使う（v1.10 までの直書きと同じ場所）
local _bfile = _C.live_path
if not _bfile then
  _bfile = "C:\\ProgramData\\aviutl2\\Plugin\\CurveEditor2\\CurveEditor2Live_active.lua"
  local _ok, _sp = pcall(obj.getinfo, "script_path")
  if _ok and type(_sp) == "string" then
    local _root = _sp:match("^(.*[\\/])[Ss][Cc][Rr][Ii][Pp][Tt][\\/]?$")
      or _sp:match("^(.*[\\/])[Ss][Cc][Rr][Ii][Pp][Tt][\\/][^\\/]+[\\/]?$")
    if _root then
      _bfile = _root .. "Plugin\\CurveEditor2\\CurveEditor2Live_active.lua"
    end
  end
  _C.live_path = _bfile
end
local _content = ""
local _pf = io.open(_bfile, "r")
if _pf then
  _content = _pf:read("*a") or ""
  _pf:close()
end

-- 同じスロット・同じ内容のエラーは 1 回だけ出す（式を直して Live が変われば出し直す）
local function _report(slot, msg)
  local key = slot .. "\n" .. msg
  if _C.errors[key] or _C.error_count >= 16 then return end
  _C.errors[key] = true
  _C.error_count = _C.error_count + 1
